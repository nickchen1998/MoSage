{
  "name": "mosage",
  "version": "0.1.2",
  "description": "Scaffold a MoSage workspace with agent skills preconfigured.",
  "type": "module",
  "bin": {
    "mosage": "dist/cli.js"
  },
  "files": [
    "dist",
    "template",
    "README.md",
    "README.zh-TW.md"
  ],
  "scripts": {
    "build": "node scripts/sync-template-skills.mjs && tsdown",
    "typecheck": "tsc --noEmit",
    "sync:template-skills": "node scripts/sync-template-skills.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "document",
    "report",
    "pdf",
    "scaffold"
  ],
  "license": "MIT",
  "author": {
    "name": "CHENBOHAN",
    "url": "https://github.com/nickchen1998"
  },
  "homepage": "https://github.com/nickchen1998/MoSage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickchen1998/MoSage.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/nickchen1998/MoSage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/prompts": "^2.4.9",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "contributors": [
    {
      "name": "Simon Liu",
      "url": "https://github.com/LiuYuWei"
    }
  ]
}
