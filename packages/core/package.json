{
  "name": "mosage-core",
  "version": "0.7.0",
  "description": "Runtime and CLI for MoSage — write documents in docs/, we handle the pages, print layout, and export.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "import": "./dist/ops/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./env": {
      "types": "./env.d.ts"
    }
  },
  "bin": {
    "mosage": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "env.d.ts",
    "src/app",
    "skills",
    "README.md",
    "README.zh-TW.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm run build && playwright test",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "document",
    "report",
    "pdf",
    "react",
    "vite"
  ],
  "license": "MIT",
  "author": {
    "name": "CHENBOHAN",
    "url": "https://github.com/nickchen1998"
  },
  "homepage": "https://github.com/nickchen1998/MoSage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickchen1998/MoSage.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nickchen1998/MoSage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "chalk": "^6.0.0",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright": "~1.56.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "playwright": "*"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "contributors": [
    {
      "name": "Simon Liu",
      "url": "https://github.com/LiuYuWei"
    }
  ]
}
