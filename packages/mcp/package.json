{
  "name": "mosage-mcp",
  "version": "0.3.2",
  "description": "MCP server for MoSage — lets any agent framework list, read, write, and file documents over Streamable HTTP.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "document",
    "agent"
  ],
  "license": "MIT",
  "author": {
    "name": "CHENBOHAN",
    "url": "https://github.com/nickchen1998"
  },
  "homepage": "https://github.com/nickchen1998/MoSage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickchen1998/MoSage.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/nickchen1998/MoSage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "mosage-core": "^0.6.0"
  },
  "devDependencies": {
    "mosage-core": "workspace:*",
    "@types/node": "^22.19.17",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "contributors": [
    {
      "name": "Simon Liu",
      "url": "https://github.com/LiuYuWei"
    }
  ]
}
